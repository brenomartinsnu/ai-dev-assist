## HTTP Server Pattern

```clojure
;; diplomat/http_server/card_identify.clj
(ns better-call-saul.diplomat.http-server.card-identify
  (:require [better-call-saul.adapters.card-identify          :as adapters.card-identify]
            [better-call-saul.controllers.card-identify        :as controllers.card-identify]
            [better-call-saul.wire.in.card-identify            :as wire.in.card-identify]
            [better-call-saul.wire.out.card-identify           :as wire.out.card-identify]
            [common-io.interceptors.adapt                      :as adapt]
            [common-io.interceptors.auth                       :as auth]
            [common-io.interceptors.doc                        :as doc]))

(defn identify-card
  [{:keys [data components]}]
  (let [{:keys [http]} components
        result (-> (adapters.card-identify/wire->model data)
                   (controllers.card-identify/identify! http)
                   (adapters.card-identify/model->wire))]
    {:status 200 :body result}))

(def routes
  #{["/api/activation/identify-card"
     :post (conj common-interceptors
                 (doc/desc "Identify a card by proto-card-id or pan-encrypted")
                 (auth/allow? #{"cards-admin"})
                 (adapt/coerce! wire.in.card-identify/IdentifyCardRequest)
                 (adapt/externalize! {200 wire.out.card-identify/ProtoCard})
                 identify-card)
     :route-name :identify-card]})
```

Routes must be merged into `diplomat/http_server.clj` via `set/union`.

