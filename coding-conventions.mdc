## HTTP Client Pattern

```clojure
;; diplomat/http_client/tremiliques.clj
(ns better-call-saul.diplomat.http-client.tremiliques
  (:require [better-call-saul.models.card-identify :as models.card-identify]
            [better-call-saul.wire.out.card-identify :as wire.out.card-identify]
            [common-core.protocols.http-client :as protocols.http-client]
            [schema.core :as s]))

(def bookmarks-settings
  {:tremiliques/identify-card
   [{:method       :post
     :schema-resps {200 wire.out.card-identify/ProtoCard}}]})

(s/defn identify-card! :- models.card-identify/ProtoCard
  [request :- models.card-identify/IdentifyRequest
   http    :- protocols.http-client/IHttpClient]
  (protocols.http-client/req! http {:method :post
                                    :url    :tremiliques/identify-card
                                    :body   (adapters.card-identify/model->wire request)}))
```

